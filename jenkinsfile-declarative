pipeline {

    /*
     * ================================================================
     * 1. AGENT
     * ================================================================
     *
     * Jenkins needs a machine/agent on which it will execute commands.
     *
     * agent any
     *     -> Jenkins can select any available Jenkins agent.
     *
     * In a real enterprise environment, you may instead have:
     *
     *     agent {
     *         label 'docker-k8s-agent'
     *     }
     *
     * or use Kubernetes-based dynamic Jenkins agents.
     */
    agent any


    /*
     * ================================================================
     * 2. ENVIRONMENT VARIABLES
     * ================================================================
     *
     * These are normal variables, NOT secrets.
     *
     * Secrets should NEVER be hard-coded here.
     */

    environment {

        // Docker/JFrog repository
        DOCKER_REGISTRY = 'company.jfrog.io'

        // Docker repository
        DOCKER_REPO = 'docker-prod'

        // Application name
        APP_NAME = 'myapp'

        // Image tag
        // BUILD_NUMBER is automatically provided by Jenkins.
        IMAGE_TAG = "${BUILD_NUMBER}"

        // Complete Docker image name
        IMAGE_NAME = "${DOCKER_REGISTRY}/${DOCKER_REPO}/${APP_NAME}:${BUILD_NUMBER}"

        // Kubernetes namespace
        K8S_NAMESPACE = 'myapp-dev'

        // Kubernetes deployment name
        K8S_DEPLOYMENT = 'myapp'

        // Kubernetes container name
        K8S_CONTAINER = 'myapp'
    }


    /*
     * ================================================================
     * 3. OPTIONS
     * ================================================================
     */

    options {

        // Keep only the last 10 builds
        buildDiscarder(
            logRotator(
                numToKeepStr: '10'
            )
        )

        // Prevent overlapping deployments
        disableConcurrentBuilds()

        // Add timestamps to Jenkins console logs
        timestamps()

        // Fail pipeline if it takes more than 30 minutes
        timeout(time: 30, unit: 'MINUTES')
    }


    /*
     * ================================================================
     * 4. PARAMETERS
     * ================================================================
     *
     * Allows a user to select the environment when starting
     * the Jenkins job manually.
     */

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'prod'],
            description: 'Select deployment environment'
        )
    }


    /*
     * ================================================================
     * 5. STAGES
     * ================================================================
     */

    stages {


        /*
         * ============================================================
         * STAGE 1 - CHECKOUT CODE
         * ============================================================
         */

        stage('Checkout') {

            steps {

                /*
                 * Jenkins checks out source code from GitHub.
                 *
                 * credentialsId:
                 *
                 * This is NOT the actual username/password/token.
                 *
                 * It is the ID of a credential stored inside
                 * Jenkins -> Manage Jenkins -> Credentials.
                 *
                 * Example:
                 *
                 *     github-credentials
                 *
                 * Jenkins retrieves the actual secret internally.
                 */

                git(
                    branch: 'main',

                    url: 'https://github.com/company/myapp.git',

                    credentialsId: 'github-credentials'
                )
            }
        }


        /*
         * ============================================================
         * STAGE 2 - BUILD APPLICATION
         * ============================================================
         */

        stage('Build') {

            steps {

                /*
                 * Example for Java/Maven application.
                 *
                 * Jenkins agent must have Maven/JDK installed
                 * OR we can use a Docker-based Jenkins agent.
                 */

                sh '''
                    echo "Building application..."

                    mvn clean package -DskipTests
                '''
            }
        }


        /*
         * ============================================================
         * STAGE 3 - UNIT TEST
         * ============================================================
         */

        stage('Unit Test') {

            steps {

                sh '''
                    echo "Running unit tests..."

                    mvn test
                '''
            }

            post {

                /*
                 * Publish JUnit test results.
                 *
                 * Jenkins can display:
                 *
                 *     Tests executed
                 *     Passed
                 *     Failed
                 *     Skipped
                 */

                always {

                    junit(
                        testResults: '**/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }


        /*
         * ============================================================
         * STAGE 4 - SONARQUBE
         * ============================================================
         */

        stage('SonarQube Analysis') {

            steps {

                /*
                 * withSonarQubeEnv()
                 *
                 * Jenkins gets the SonarQube server configuration.
                 *
                 * Example configured in:
                 *
                 * Jenkins
                 *   ->
                 * Manage Jenkins
                 *   ->
                 * System
                 *   ->
                 * SonarQube servers
                 *
                 * "SonarQube-Prod" is the name configured there.
                 */

                withSonarQubeEnv('SonarQube-Prod') {

                    sh '''
                        mvn sonar:sonar
                    '''
                }
            }
        }


        /*
         * ============================================================
         * STAGE 5 - QUALITY GATE
         * ============================================================
         */

        stage('Quality Gate') {

            steps {

                /*
                 * Jenkins waits for SonarQube to process the scan.
                 *
                 * If SonarQube says:
                 *
                 *     OK
                 *
                 * pipeline continues.
                 *
                 * If:
                 *
                 *     ERROR
                 *
                 * pipeline stops.
                 */

                timeout(time: 5, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        /*
         * ============================================================
         * STAGE 6 - DOCKER BUILD
         * ============================================================
         */

        stage('Docker Build') {

            steps {

                sh '''
                    echo "Building Docker image..."

                    docker build \
                        -t ${IMAGE_NAME} \
                        .
                '''
            }
        }


        /*
         * ============================================================
         * STAGE 7 - DOCKER LOGIN + PUSH TO JFROG
         * ============================================================
         */

        stage('Push Image to JFrog') {

            steps {

                /*
                 * IMPORTANT:
                 *
                 * We do NOT do:
                 *
                 *     docker login -u admin -p password
                 *
                 * Never hard-code credentials.
                 *
                 * Instead:
                 *
                 *     credentialsId: 'jfrog-docker-creds'
                 *
                 * Jenkins retrieves the credential securely.
                 */

                withCredentials(
                    [
                        usernamePassword(
                            credentialsId: 'jfrog-docker-creds',

                            usernameVariable: 'JFROG_USER',

                            passwordVariable: 'JFROG_PASSWORD'
                        )
                    ]
                ) {

                    sh '''
                        echo "Logging into JFrog..."

                        echo "$JFROG_PASSWORD" | docker login \
                            ${DOCKER_REGISTRY} \
                            -u "$JFROG_USER" \
                            --password-stdin


                        echo "Pushing Docker image..."

                        docker push ${IMAGE_NAME}


                        echo "Docker push completed."
                    '''
                }
            }
        }


        /*
         * ============================================================
         * STAGE 8 - KUBERNETES DEPLOYMENT
         * ============================================================
         */

        stage('Deploy to Kubernetes') {

            steps {

                /*
                 * There are multiple ways to deploy to Kubernetes.
                 *
                 * Common enterprise approaches:
                 *
                 * 1. kubectl
                 * 2. Helm
                 * 3. Argo CD
                 * 4. Jenkins Kubernetes plugin
                 *
                 * Here we use kubectl because it makes the mechanics
                 * easy to understand.
                 */

                withCredentials(
                    [
                        file(
                            credentialsId: 'kubernetes-config',
                            variable: 'KUBECONFIG'
                        )
                    ]
                ) {

                    sh '''
                        echo "Deploying to Kubernetes..."

                        kubectl config current-context

                        kubectl get namespace ${K8S_NAMESPACE}


                        /*
                         * Update the image of the existing deployment.
                         */

                        kubectl set image deployment/${K8S_DEPLOYMENT} \
                            ${K8S_CONTAINER}=${IMAGE_NAME} \
                            -n ${K8S_NAMESPACE}


                        /*
                         * Wait until Kubernetes rollout completes.
                         */

                        kubectl rollout status \
                            deployment/${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE} \
                            --timeout=5m
                    '''
                }
            }
        }


        /*
         * ============================================================
         * STAGE 9 - VERIFY KUBERNETES
         * ============================================================
         */

        stage('Verify Deployment') {

            steps {

                withCredentials(
                    [
                        file(
                            credentialsId: 'kubernetes-config',
                            variable: 'KUBECONFIG'
                        )
                    ]
                ) {

                    sh '''
                        echo "Checking pods..."

                        kubectl get pods \
                            -n ${K8S_NAMESPACE}


                        echo "Checking deployment..."

                        kubectl get deployment ${K8S_DEPLOYMENT} \
                            -n ${K8S_NAMESPACE}


                        echo "Checking service..."

                        kubectl get service \
                            -n ${K8S_NAMESPACE}
                    '''
                }
            }
        }


        /*
         * ============================================================
         * STAGE 10 - SMOKE TEST
         * ============================================================
         */

        stage('Smoke Test') {

            steps {

                sh '''
                    echo "Running application smoke test..."

                    curl -f https://myapp-dev.company.com/health

                    echo "Smoke test successful."
                '''
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     *
     * These execute after the pipeline finishes.
     */

    post {

        success {

            echo '''
            ============================================
            DEPLOYMENT SUCCESSFUL
            ============================================
            '''
        }

        failure {

            echo '''
            ============================================
            PIPELINE FAILED
            ============================================
            '''
        }

        always {

            /*
             * Cleanup workspace.
             *
             * Requires Workspace Cleanup Plugin.
             */

            cleanWs()
        }
    }
}
